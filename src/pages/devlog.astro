---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import "../styles/global.scss";
import "../styles/devlog.scss";
import Home from "../components/Home.astro";

const devlogEntries = await getCollection("devlog");
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Projects</title>
        <script src="../scripts/sounds.js"></script>
    </head>
    <body>
        <div class="DevlogContainer">
            <div>
                <h1>Projects WIP</h1>
            </div>
            <div class="DevlogGrid">
                {
                    devlogEntries.map((entry: any) => (
                        <div class="DevlogItem">
                            {entry.data.devlogTitle}
                            <Image
                                src={entry.data.devlogLogo}
                                alt={entry.data.devlogTitle}
                            />
                            {entry.data.devlogTag}
                        </div>
                    ))
                }
            </div>
        </div>
    </body>
    <Home />
</html>
